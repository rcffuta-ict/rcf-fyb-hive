# ─────────────────────────────────────────────────────────────
# FYB Hive — environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (server-side only — service role bypasses RLS; do NOT expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin session — secret used to sign the httpOnly admin cookie.
# Generate one, e.g.:  openssl rand -hex 32
ADMIN_COOKIE_SECRET=replace-with-a-long-random-string

# Transactional email — shared secret the app sends as `x-drain-secret` when it
# pings the `send-fyb-email` Edge Function. Must match the value set via
# `supabase secrets set EMAIL_DRAIN_SECRET=…`, or every drain returns 401.
# Generate one, e.g.:  openssl rand -hex 32
EMAIL_DRAIN_SECRET=replace-with-a-long-random-string

# Hidden email-ops page — the URL segment IS the credential:
#   https://fyb.rcffuta.com/ops/<OPS_KEY>
# Linked from nowhere and noindex'd. A wrong key renders a normal 404, so the
# page can't be found by probing. Must be >= 16 chars or the page stays off.
# Generate one, e.g.:  openssl rand -hex 24
OPS_KEY=replace-with-a-long-random-string

# Cloudinary (profile/registration photo uploads + face detection)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
