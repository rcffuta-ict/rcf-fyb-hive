        },
        {
            "key": "most-influential-male",
            "title": "Most Influential (Male)",
            "entryKind": "individual",
            "gender": "male",
            "blurb": "Someone's direction actually changed because of them. Named someones.",
            "definition": "Positive influence that measurably shaped someone else's mindset, habit, or direction for the better.",
            "disqualifiers": [
                "Having many friends or followers",
                "Being loud or outspoken",
                "Holding a leadership title",
                "Compliance driven by fear or pressure"
            ],
            "checklist": [
