        {
            // A brand stands on the ballot as itself: its name and its logo.
            // The founders are recorded and shown in admin stats, because
            // "one win per person" is a rule about people — but the voter is
            // voting for the business, not for a face.
            "key": "brand-of-the-year",
            "title": "Brand of the Year",
            "entryKind": "brand",
            "gender": "any",
            "blurb": "A real, running business founded by an FYB — with real customers.",
            "definition": "Recognizes a business or service founded or co-founded by an FYB member of the fellowship — not the member's personal image, and not a business they merely work for. Where there is more than one FYB co-founder, all named co-founders share the award.",
            "disqualifiers": [
                "A business page or Instagram account with no real customers",
                "A business idea or plan not yet running",
                "One sale or a one-off transaction",
                "The owner's personal popularity, style, or likeability, separate from the business itself"
            ],
            "checklist": [
                "Nominee is an active FYB member this session, and is the founder or co-founder — not an employee, staff, affiliate, or reseller",
                "Business or service has been actively operating for at least 1 full semester, and is still running at the time of nomination",
                "Named, verifiable customers or clients beyond the owner's close friends and family",
                "Nominator describes specifically what the business offers, with concrete evidence of growth, quality, or reliability — repeat customers, specific outcomes, order volume",
                "Corroborated by at least one customer or client who is not a close friend of the owner",
                "No credible evidence raised during screening of poor service, unresolved complaints, or dishonest business practice"
            ]
        },
        {
            // A clique stands as a group. No logo — the faces of its members
            // laid out together are the entry. Every member must be a
            // registered finalist, so each one has a photo to show.
            "key": "clique-of-the-year",
            "title": "Clique of the Year",
            "entryKind": "clique",
            "gender": "any",
            "blurb": "A real friendship, years deep. Not the most photographed table.",
            "definition": "Recognizes a group demonstrating genuine, long-standing, close-knit friendship — mutual support, shared experiences, consistency, and positive Christian influence. Not the most popular, visible, or photographed group.",
            "disqualifiers": [
                "Attending church, Bible study, or fellowship together",
                "Sitting together, or serving in the same unit",
                "Same department, level, or class",
                "Having a group chat, frequent photos, matching outfits, or a group nickname",
                "Popularity, or one or two shared events"
            ],
            "checklist": [
                "At least 3 members with genuine relationships with one another",
                "Existed for 2 or more academic sessions, demonstrably",
                "Members voluntarily spend time together outside required activities",
                "Relationship extends beyond a shared class, level, department, unit, or fellowship group",
                "Members have meaningful relationships with several others, not just one central person — no hub-and-spoke",
                "Multiple genuine shared experiences over time, not just event photos",
                "Evidence of mutual support in practical, academic, personal, or spiritual matters",
                "Relationship remained meaningful despite changes in circumstances — classes, units, schedules",
                "Healthy conduct consistent with Christian fellowship — not hostile or exclusive",
                "Nominator provides specific supporting examples, not assumptions"
            ],
            "note": {
                "title": "The \"No Camera\" Test",
                "body": "If there were no pictures, no social media, no award, and nobody was watching — would these people still choose each other's company? If yes, that's real evidence."
            }
        }
    ]
}
